# Local development: use PG* variables instead of DATABASE_URL.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=velora
PGDATABASE=velora
PORT=3000
# Supply a private random signing key before starting. Never commit .env.
JWT_SECRET=
# Optional: leave unset to disable generation. Never store a real token here.
REPLICATE_API_TOKEN=

# Explicitly disabled until a separately approved provider check.
ENABLE_GENERATION=false
# 0 for direct local traffic. Confirm proxy topology before using 1 on Render.
TRUST_PROXY_HOPS=0
